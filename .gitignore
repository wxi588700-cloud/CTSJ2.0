# Byte-compiled / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Large external algorithm downloads (RFdiffusion / ProteinMPNN / weights).
# A setup script copies them from a local source directory; they are never
# committed to git (GitHub 100 MB file limit).
external/
weights/
# model WEIGHTS are never committed; the models/ directory itself (Model Card,
# third-party model inventory) IS part of the submission structure.
models/*.pt
models/*.ckpt
models/*.pkl
models/*.tar

# Run outputs are reproducible artifacts; curated examples live in results/
# and logs/ which ARE committed.
outputs/
!outputs/.gitkeep

# Data policy: small primary input structures ARE committed (data/raw);
# anything fetched or derived later is not.
data/processed/
data/*/rfdiffusion_cache/

# OS / editor
.DS_Store
*.swp
.vscode/
.idea/

# notebook checkpoints
.ipynb_checkpoints/
